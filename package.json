{
  "name": "docker-cd-deploy-workflow",
  "version": "1.0.0",
  "description": "Reusable GitHub Actions workflow for instant Docker deploys. When an app repo pushes a tag, this workflow updates the image tag in your home-ops repo, triggering docker-cd to deploy.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test src/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wajeht/docker-cd-deploy-workflow.git"
  },
  "keywords": [],
  "author": "wajeht",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wajeht/docker-cd-deploy-workflow/issues"
  },
  "homepage": "https://github.com/wajeht/docker-cd-deploy-workflow#readme",
  "dependencies": {
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.1",
    "typescript": "^6.0.3"
  }
}
